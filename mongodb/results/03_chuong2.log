===== [ch2] yc14
db.makers.aggregate([
  { $match: { "products.type": "laptop" } },
  { $lookup: {
      from: "products",
      localField: "products.model",
      foreignField: "model",
      as: "chiTiet"
  } },
  { $project: {
      _id: 0, maker: "$_id",
      laptops: { $filter: { input: "$chiTiet", as: "p", cond: { $eq: ["$$p.type", "laptop"] } } }
  } },
  { $project: {
      maker: 1,
      soLaptop: { $size: "$laptops" },
      dsModel: { $sortArray: { input: "$laptops.model", sortBy: 1 } },
      giaTB: { $round: [ { $avg: "$laptops.price" }, 2 ] },
      ramMax: { $max: "$laptops.specs.ram" }
  } },
  { $sort: { maker: 1 } }
])
----->
[
  {
    maker: 'A',
    soLaptop: 3,
    dsModel: [ 2004, 2005, 2006 ],
    giaTB: 1783.33,
    ramMax: 2048
  },
  {
    maker: 'B',
    soLaptop: 1,
    dsModel: [ 2007 ],
    giaTB: 1429,
    ramMax: 1024
  },
  {
    maker: 'E',
    soLaptop: 3,
    dsModel: [ 2001, 2002, 2003 ],
    giaTB: 1723.67,
    ramMax: 2048
  },
  {
    maker: 'F',
    soLaptop: 2,
    dsModel: [ 2008, 2009 ],
    giaTB: 790,
    ramMax: 1024
  },
  {
    maker: 'G',
    soLaptop: 1,
    dsModel: [ 2010 ],
    giaTB: 2300,
    ramMax: 2048
  }
]

